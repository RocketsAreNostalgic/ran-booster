<?xml version="1.0"?>
<ruleset name="RAN Booster Coding Standards">
	<description>WordPress and PHP compatibility checks for RAN Booster.</description>

	<config name="minimum_wp_version" value="7.0"/>
	<config name="testVersion" value="8.2-"/>

	<file>.</file>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/ran-booster-workbench/</exclude-pattern>
	<exclude-pattern>/.phpunit.cache/</exclude-pattern>
	<exclude-pattern>/.phpcs-cache</exclude-pattern>
	<exclude-pattern>/.plugin-check/</exclude-pattern>
	<exclude-pattern>/coverage/</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="4"/>
	<arg value="sp"/>

	<rule ref="RANWordPressPlugin"/>

	<!-- All owned PHP declarations, including inherited implementations and test helpers,
	     use snake_case. Native framework obligations require declaration-local exceptions. -->
	<rule ref="RANOwnedMethods"/>
	<!-- Variable, property and named-parameter enforcement covers the complete owned tree. -->
	<rule ref="WordPress.NamingConventions.ValidVariableName"/>
	<!-- Audited condition cohorts preserve evaluation order; broader condition scope remains under #167 acceptance. -->
	<rule ref="WordPress.PHP.YodaConditions">
		<include-pattern>/RAN/Admin/RepositoryPickerController.php</include-pattern>
		<include-pattern>/RAN/Admin/ManagedPackageWebhookAuthorityResolver.php</include-pattern>
		<include-pattern>/RAN/Deployment/AdmittedBranchHostAdapter.php</include-pattern>
		<include-pattern>/RAN/WordPress/CorePackageExecutor.php</include-pattern>
		<include-pattern>/RAN/WordPress/ManagedReleaseStore.php</include-pattern>
		<include-pattern>/RAN/Admin/ProviderProfileAdminController.php</include-pattern>
		<include-pattern>/RAN/WordPress/ManagedReleaseTargetRegistrar.php</include-pattern>
		<include-pattern>/RAN/WordPress/CoreSelfUpdatePolicy.php</include-pattern>
		<include-pattern>/RAN/Uninstall/LocalDataRemover.php</include-pattern>
		<include-pattern>/RAN/Admin/Component/AdminActionNormalizer.php</include-pattern>
		<include-pattern>/RAN/Portability/BlueprintPackage.php</include-pattern>
		<include-pattern>/RAN/Deployment/ReleaseArtifactCustodian.php</include-pattern>
		<include-pattern>/RAN/RepositoryProvider/GitReferenceSyntax.php</include-pattern>
		<include-pattern>/RAN/Secrets/WpConfigSecretsPathWriter.php</include-pattern>
		<include-pattern>/RAN/Portability/BlueprintArchive.php</include-pattern>
		<include-pattern>/RAN/RepositoryProvider/ProviderCode.php</include-pattern>
		<include-pattern>/RAN/Portability/ManagedPackageBlueprintExporter.php</include-pattern>
		<include-pattern>/RAN/PackageOperation.php</include-pattern>
		<include-pattern>/RAN/Secrets/PrivateLocationCandidateResolver.php</include-pattern>
		<include-pattern>/RAN/Admin/WebhookManagement/RepositoryWebhookManagementControls.php</include-pattern>
		<include-pattern>/views/portability.php</include-pattern>
		<include-pattern>/RAN/Secrets/SecretsFile.php</include-pattern>
		<include-pattern>/RAN/Admin/WebhookManagement/Display/WebhookDisplayModel.php</include-pattern>
		<include-pattern>/RAN/Admin/ReleaseManagement/ReleaseManagementControls.php</include-pattern>
		<include-pattern>/RAN/Storage/AbstractPackageRepository.php</include-pattern>
		<include-pattern>/RAN/Storage/Database.php</include-pattern>
		<include-pattern>/RAN/Storage/RepositorySourceGuard.php</include-pattern>
		<include-pattern>/RAN/Admin/ReleaseManagement/ProspectiveReleaseOperations.php</include-pattern>
		<include-pattern>/RAN/Admin/ProviderRepositoryRowsNormalizer.php</include-pattern>
		<include-pattern>/RAN/Admin/PackageRepositoryRequestResolver.php</include-pattern>
		<include-pattern>/RAN/Admin/ProviderSettingsPresenter.php</include-pattern>
		<include-pattern>/RAN/Admin/PortabilityController.php</include-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/</exclude-pattern>
		<!-- Template locals are passed into included view files; they are not plugin globals. -->
		<exclude-pattern>/views/</exclude-pattern>
		<properties>
			<property name="prefixes" type="array">
				<element value="ran_booster"/>
				<!-- Booster intentionally contains multiple established production namespaces below the RAN root. -->
				<element value="RAN\"/>
			</property>
		</properties>
	</rule>

	<!-- WPCS 3.4 hard-codes a four-character minimum; Booster's established production namespace root is RAN. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedNamespaceFound">
		<severity>0</severity>
	</rule>

	<!-- Audited owned parameters block the canonical standards command; concrete callback/compact contracts are line-local. -->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<type>error</type>
		<include-pattern>/RAN/WordPress/CorePackageExecutor.php</include-pattern>
		<include-pattern>/RAN/Admin/DeploymentAdminPresenter.php</include-pattern>
		<include-pattern>/RAN/RepositoryProvider/RepositoryDescriptor.php</include-pattern>
		<include-pattern>/RAN/RepositoryProvider/PushEvent.php</include-pattern>
		<include-pattern>/RAN/RepositoryProvider/RepositoryReference.php</include-pattern>
		<include-pattern>/RAN/Secrets/SecretsStorageProvisioner.php</include-pattern>
		<include-pattern>/RAN/RepositoryProvider/RepositoryBrowseRequest.php</include-pattern>
		<include-pattern>/RAN/AddOn/ReleaseTracking/NativeReleaseTrackingFacade.php</include-pattern>
		<include-pattern>/RAN/Admin/ReleaseManagement/ReleaseManagementDisplay.php</include-pattern>
	</rule>
	<!-- WPCS class-wide callback exemptions also hide private helpers; these code overrides inherit the audited nine-path scope above. -->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.FoundBeforeLastUsed">
		<severity>5</severity>
		<type>error</type>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.FoundInExtendedClass">
		<severity>5</severity>
		<type>error</type>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.FoundInExtendedClassBeforeLastUsed">
		<severity>5</severity>
		<type>error</type>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.FoundInExtendedClassAfterLastUsed">
		<severity>5</severity>
		<type>error</type>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.FoundInImplementedInterface">
		<severity>5</severity>
		<type>error</type>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.FoundInImplementedInterfaceBeforeLastUsed">
		<severity>5</severity>
		<type>error</type>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.FoundInImplementedInterfaceAfterLastUsed">
		<severity>5</severity>
		<type>error</type>
	</rule>
	<!-- These request types have no external signature obligation; enforce audited parameter names. -->
	<rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames">
		<include-pattern>/RAN/PackageOperation.php</include-pattern>
		<include-pattern>/RAN/Deployment/DeploymentRequest.php</include-pattern>
	</rule>

	<!-- The focused container unit test keeps its tiny fixture classes beside the assertions. -->
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<exclude-pattern>/tests/Container/ContainerTest.php</exclude-pattern>
		<exclude-pattern>/tests/Booster/GitHub/WebhookManagement/WebhookManagementControllerTest.php</exclude-pattern>
	</rule>

	<!-- The migrated behavior fixture intentionally exercises raw request arrays and exact serialized legacy records. -->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.serialize_serialize">
		<exclude-pattern>/tests/Booster/GitHub/WebhookManagement/WebhookManagementControllerTest.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.parse_url_parse_url">
		<exclude-pattern>/tests/Booster/GitHub/WebhookManagement/WebhookManagementControllerTest.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.NonceVerification.Recommended">
		<exclude-pattern>/tests/Booster/GitHub/WebhookManagement/WebhookManagementControllerTest.php</exclude-pattern>
	</rule>

	<!-- The single-file characterization harness is CLI-only and asserts source text verbatim. -->
	<rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
		<exclude-pattern>/tests/characterization.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<exclude-pattern>/tests/characterization.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput.OutputNotEscaped">
		<exclude-pattern>/tests/characterization.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.CapitalPDangit.MisspelledInText">
		<exclude-pattern>/tests/characterization.php</exclude-pattern>
	</rule>

	<!--
		SecretsFile uses a site-owned encrypted JSON sidecar and atomic temp-file + rename writes.
		WP_Filesystem cannot provide the same same-directory atomic replacement contract.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/RAN/Secrets/SecretsFile.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ran-booster"/>
			</property>
		</properties>
	</rule>
</ruleset>
