<?xml version="1.0"?>
<ruleset name="RAN Booster Coding Standards">
	<description>WordPress and PHP compatibility checks for RAN Booster.</description>

	<config name="minimum_wp_version" value="7.0"/>
	<config name="testVersion" value="8.2-"/>

	<file>.</file>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/ran-booster-workbench/</exclude-pattern>
	<exclude-pattern>/.phpunit.cache/</exclude-pattern>
	<exclude-pattern>/.phpcs-cache</exclude-pattern>
	<exclude-pattern>/.plugin-check/</exclude-pattern>
	<exclude-pattern>/coverage/</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="4"/>
	<arg value="sp"/>

	<rule ref="RANWordPressPlugin"/>

	<!-- All owned PHP declarations, including inherited implementations and test helpers,
	     use snake_case. Native framework obligations require declaration-local exceptions. -->
	<rule ref="RANOwnedMethods"/>
	<!-- Variable, property and named-parameter enforcement covers the complete owned tree. -->
	<rule ref="WordPress.NamingConventions.ValidVariableName"/>
	<!-- Whole-tree conditions retain only documented annotation exceptions. -->
	<rule ref="WordPress.PHP.YodaConditions"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ran_booster"/>
				<!-- Booster intentionally contains multiple established production namespaces below the RAN root. -->
				<element value="RAN\"/>
			</property>
		</properties>
	</rule>

	<!-- Immutable generated Admin Shell is verified independently; handwritten view exceptions are local. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>/views/generated/ran-admin-shell\.php$</exclude-pattern>
	</rule>


	<!-- Unused parameters block across the owned tree; required signatures and implicit-use contracts are declaration-local. -->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<type>error</type>
	</rule>
	<!-- WPCS class-wide callback exemptions also hide private helpers; keep every diagnostic blocking across the same whole-tree scope. -->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.FoundBeforeLastUsed">
		<severity>5</severity>
		<type>error</type>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.FoundInExtendedClass">
		<severity>5</severity>
		<type>error</type>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.FoundInExtendedClassBeforeLastUsed">
		<severity>5</severity>
		<type>error</type>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.FoundInExtendedClassAfterLastUsed">
		<severity>5</severity>
		<type>error</type>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.FoundInImplementedInterface">
		<severity>5</severity>
		<type>error</type>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.FoundInImplementedInterfaceBeforeLastUsed">
		<severity>5</severity>
		<type>error</type>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.FoundInImplementedInterfaceAfterLastUsed">
		<severity>5</severity>
		<type>error</type>
	</rule>
	<!-- Reserved parameter names are checked throughout; retained public/native signatures are declaration-local. -->
	<rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ran-booster"/>
			</property>
		</properties>
	</rule>
</ruleset>
