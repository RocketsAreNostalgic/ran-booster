{
    "name": "ran/booster",
    "description": "Repository deployment management for WordPress themes and plugins.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-only",
    "support": {
        "issues": "https://github.com/RocketsAreNostalgic/ran-booster/issues",
        "source": "https://github.com/RocketsAreNostalgic/ran-booster"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/RocketsAreNostalgic/ran-wp-github-release-updater.git"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "RAN\\": "RAN/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "ext-sodium": "*",
        "ext-zip": "*",
        "ran/wp-github-release-updater": "2.0.0-beta.6"
    },
    "scripts": {
        "test:characterization": "@php tests/characterization.php",
        "test:github-module": "phpunit --configuration phpunit.github-module.xml",
        "test:unit": "phpunit --configuration phpunit.xml",
        "test:delivery-intake-race": "bash tests/WordPress/delivery-intake-race.sh",
        "test:worker-hard-stop": "bash tests/WordPress/worker-hard-stop.sh",
        "test:native-lock-race": "bash tests/WordPress/native-updater-lock-race.sh",
        "test:core-updater-proof": "bash tests/WordPress/core-updater-proof.sh",
        "test:core-package-executor": "bash tests/WordPress/core-package-executor-smoke.sh",
        "test:release-capability-installed": "bash tests/WordPress/release-capability-installed-smoke.sh",
        "test:github-release-updater-bootstrap": "@php tests/WordPress/github-release-updater-bootstrap-smoke.php",
        "test:database-storage-smoke": "bash tests/WordPress/database-storage-smoke.sh",
        "test": [
            "@test:characterization",
            "@test:github-module",
            "@test:unit",
            "@test:github-release-updater-bootstrap",
            "@test:release-candidate-contract"
        ],
        "lint:php": "phpcs --standard=.phpcs.xml --report=summary",
        "lint:php:fix": "phpcbf --standard=.phpcs.xml --report=summary",
        "test:release-candidate-contract": "bash tests/release-candidate-contract.sh",
        "test:release-candidate-marker": "bash tests/reconcile-release-candidate-marker.sh",
        "test:release-state-contracts": "bash tests/release-state-contracts.sh",
        "test:quality-fallback-contract": "bash tests/quality-fallback-contract.sh",
        "build:release": "bash scripts/build-release.sh",
        "verify:release": "bash scripts/verify-release.sh",
        "check": [
            "@test",
            "@test:release-candidate-marker",
            "@test:release-state-contracts",
            "@test:quality-fallback-contract",
            "@lint:php"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.13.5",
        "wp-coding-standards/wpcs": "^3.4",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
        "phpcsstandards/phpcsutils": "^1.2.2",
        "phpcompatibility/phpcompatibility-wp": "^3.0@dev",
        "phpcompatibility/php-compatibility": "^10.0@dev",
        "phpcompatibility/phpcompatibility-paragonie": "^2.0@dev"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
