{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transporter Blueprint V2 beta proposal",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "ran-booster-package-blueprint"
    },
    "version": {
      "const": 2
    },
    "packages": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "credentials": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/credential"
      }
    }
  },
  "required": [
    "format",
    "version",
    "packages",
    "credentials"
  ],
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "plugin",
            "theme"
          ]
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      },
      "required": [
        "type",
        "identifier"
      ]
    },
    "branch_source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "branch"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "subdirectory": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "branch",
        "subdirectory"
      ]
    },
    "release_source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "release_asset"
        },
        "channel": {
          "enum": [
            "stable",
            "prerelease"
          ]
        },
        "package_root": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "metadata_file": {
          "type": "string",
          "maxLength": 191,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      },
      "required": [
        "kind",
        "channel",
        "package_root",
        "metadata_file"
      ]
    },
    "branch_selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        }
      },
      "required": [
        "commit"
      ]
    },
    "release_selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact_size": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "release_id",
        "tag",
        "version",
        "commit",
        "artifact_id",
        "artifact_sha256",
        "artifact_size"
      ]
    },
    "observed_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": []
    },
    "declarations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requires_php": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "requires_wordpress": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "requires_plugins": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "parent_theme": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": []
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "installed_headers",
            "selected_package"
          ]
        },
        "observed_identity": {
          "$ref": "#/$defs/observed_identity"
        },
        "declarations": {
          "$ref": "#/$defs/declarations"
        }
      },
      "required": [
        "basis",
        "observed_identity",
        "declarations"
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "plugin",
            "theme"
          ]
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "provider_repository_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/branch_source"
            },
            {
              "$ref": "#/$defs/release_source"
            }
          ]
        },
        "selection": {
          "oneOf": [
            {
              "$ref": "#/$defs/branch_selection"
            },
            {
              "$ref": "#/$defs/release_selection"
            }
          ]
        },
        "requirements": {
          "$ref": "#/$defs/requirements"
        }
      },
      "required": [
        "type",
        "identifier",
        "display_name",
        "provider",
        "provider_repository_id",
        "repository",
        "source"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "properties": {
                  "kind": {
                    "const": "branch"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "selection": {
                "$ref": "#/$defs/branch_selection"
              }
            }
          },
          "else": {
            "properties": {
              "selection": {
                "$ref": "#/$defs/release_selection"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "theme"
              }
            }
          },
          "then": {
            "properties": {
              "requirements": {
                "properties": {
                  "declarations": {
                    "not": {
                      "required": [
                        "requires_plugins"
                      ]
                    }
                  }
                }
              },
              "source": {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "release_asset"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "metadata_file": {
                      "const": "style.css"
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "requirements": {
                "properties": {
                  "declarations": {
                    "not": {
                      "required": [
                        "parent_theme"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "requirements"
            ],
            "properties": {
              "requirements": {
                "properties": {
                  "basis": {
                    "const": "selected_package"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "selection"
            ]
          }
        },
        {
          "if": {
            "required": [
              "requirements"
            ],
            "properties": {
              "requirements": {
                "properties": {
                  "basis": {
                    "const": "selected_package"
                  }
                }
              }
            }
          },
          "then": {
            "if": {
              "properties": {
                "source": {
                  "properties": {
                    "kind": {
                      "const": "branch"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "requirements": {
                  "properties": {
                    "observed_identity": {
                      "required": [
                        "commit"
                      ]
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "requirements": {
                  "properties": {
                    "observed_identity": {
                      "required": [
                        "artifact_sha256"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "credential_configuration": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "configuration": {
          "$ref": "#/$defs/credential_configuration"
        },
        "secret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/identity"
          }
        }
      },
      "required": [
        "provider",
        "label",
        "kind",
        "configuration",
        "secret",
        "packages"
      ]
    }
  }
}
