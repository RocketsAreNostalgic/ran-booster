{
  "name": "ran-booster-development",
  "private": true,
  "type": "module",
  "scripts": {
        "format": "prettier --write 'assets/**/*.{js,css}' 'tests/assets/**/*.mjs'",
        "format:check": "prettier --check 'assets/**/*.{js,css}' 'tests/assets/**/*.mjs'",
        "lint:js": "eslint 'assets/**/*.js' 'tests/assets/**/*.mjs'",
        "lint:js:fix": "eslint 'assets/**/*.js' 'tests/assets/**/*.mjs' --fix",
        "lint:css": "stylelint 'assets/**/*.css'",
        "lint:css:fix": "stylelint 'assets/**/*.css' --fix",
        "test:assets": "node --test 'tests/assets/*.test.mjs'",
        "check": "pnpm format:check && pnpm lint:js && pnpm lint:css && pnpm test:assets",
        "prepare": "husky"
  },
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.7.0",
  "volta": {
    "node": "24.11.0"
  },
  "devDependencies": {
    "@wordpress/eslint-plugin": "^25.7.0",
    "@wordpress/prettier-config": "^4.51.0",
    "@wordpress/stylelint-config": "^24.0.0",
    "@zeeg/dex": "0.16.0",
    "eslint": "^9.39.5",
    "htmx.org": "2.0.10",
    "husky": "^9.1.7",
    "prettier": "^3.9.5",
    "stylelint": "^16.26.1"
  },
  "prettier": "@wordpress/prettier-config"
}
