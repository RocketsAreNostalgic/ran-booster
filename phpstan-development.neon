includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 5
	treatPhpDocTypesAsCertain: false
	paths:
		- scripts
		- tests
	# Temporary unresolved cohorts. The coverage test pins exact pending files,
	# so these roles cannot silently exempt a newly added or split file.
	excludePaths:
		analyseAndScan:
			- tests/AddOn/*
			- tests/Admin/*
			- tests/Container/*
			- tests/Deployment/*
			- tests/Integration/*
			- tests/LocalisationCatalogContractTest.php
			- tests/Logging/*
			- tests/PackageArtifactLimitTest.php
			- tests/PackageMagicReadTest.php
			- tests/PackageOperationServiceTest.php
			- tests/PackageRemovalServiceTest.php
			- tests/PackageSlugTest.php
			- tests/PackageSubdirectoryTest.php
			- tests/Portability/*
			- tests/Quality/*
			- tests/RANBoosterTestCase.php
			- tests/ReleasePlatformContractTest.php
			- tests/ReleasePromotionBoundaryTest.php
			- tests/ReleaseWorkflowContractTest.php
			- tests/RepositoryProvider/*
			- tests/Runtime/*
			- tests/RuntimePackagingPolicyNegativeTest.php
			- tests/Secrets/*
			- tests/Storage/*
			- tests/Support/*
			- tests/Troubleshooting/*
			- tests/WordPress/*
			- tests/characterization.php
			- tests/fixtures/*
	scanDirectories:
		- vendor/ran/wp-release-updater/src
