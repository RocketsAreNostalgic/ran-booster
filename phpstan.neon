includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	tmpDir: vendor/.phpstan-cache/production
	parallel:
		maximumNumberOfProcesses: 1
	level: 5
	treatPhpDocTypesAsCertain: false
	paths:
		- .
	# Root-relative development and external/generated state use their own boundaries.
	excludePaths:
		analyseAndScan:
			- ./scripts/*
			- ./tests/*
			- ./vendor/*
			- ./node_modules/*
			- ./ran-booster-workbench/*
			- ./.phpunit.cache/*
			- ./.plugin-check/*
			- ./coverage/*
	scanDirectories:
		- vendor/ran/wp-release-updater/src
